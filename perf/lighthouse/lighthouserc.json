{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "startServerCommand": "pnpm --prefix storefront start",
      "startServerReadyPattern": "Ready in",
      "startServerReadyTimeout": 60000,
      "url": [
        "http://localhost:3001/us/en",
        "http://localhost:3001/us/en/c/categories/office-wear",
        "http://localhost:3001/us/en/products",
        "http://localhost:3001/us/en/products/office-footwear-01",
        "http://localhost:3001/us/en/products?q=oxford",
        "http://localhost:3001/us/en/cart"
      ],
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "budgetsPath": "./perf/lighthouse/budget.json",
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 1500 }],
        "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.05 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 150 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
