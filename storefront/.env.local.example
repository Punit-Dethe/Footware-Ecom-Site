# First-Party PostgreSQL Database & Supabase Configuration
DATABASE_URL=postgres://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres
# Base64-encoded Supabase CA certificate. Required for strict TLS
# (rejectUnauthorized: true). Do not disable certificate verification.
SUPABASE_DB_CA_CERT_BASE64=
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key # server-only, never NEXT_PUBLIC_*
